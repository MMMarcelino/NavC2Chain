# Copy this file to .env and fill in real values.
# .env itself is gitignored and must never be committed.

# Deployer / funder account on the L1 (Besu) network.
# For a local QBFT devnet this can be any pre-funded genesis account.
ANVIL_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_DEV_KEY

# Madara sequencer signing key (devnet value; zeroed/dummy is fine for local use).
MADARA_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_DEV_KEY

# Image references. Custom images (madara, orchestrator, bootstrapper,
# stwo-gateway) are built from source per docs/BUILD.md; the rest are
# public images pinned by version and content digest for reproducibility.
MADARA_IMAGE=madara:local
ORCHESTRATOR_IMAGE=madara-orchestrator:v0.10.2
BOOTSTRAPPER_IMAGE=madara-bootstrapper-v2:v0.10.2
PATHFINDER_IMAGE=karnotxyz-pathfinder:v0.14.1-alpha.4
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:v1.7.1@sha256:8347b728d5d393dac1c018691b36f506d23b9dcd78341d40ea0fcb11c3a19cdd
MONGO_IMAGE=mongo:8.2.7@sha256:7abfba0d07c9330373f8173981ea4d09cd8a82cdf0e86ccaf7008848d1d24f62
LOCALSTACK_IMAGE=localstack/localstack@sha256:763947722c6c8d33d5fbf7e8d52b4bddec5be35274a0998fdc6176d733375314
PATHFINDER_ETH_WS_URL=ws://besu-validator1:8546
UID=1000
GID=1000

# Add any other variables referenced by compose.yaml / orchestrator.env here,
# following the same REPLACE_ME convention. Check `grep -o '\${[A-Z_]*}' compose.yaml`
# for the full list of variables compose.yaml expects.
